root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140

# Domain package contains underscore (com.schwarz_digits.mobilecommunity)
ktlint_standard_package-name = disabled

# Jetpack Compose @Composable functions use PascalCase convention
ktlint_standard_function-naming = disabled
