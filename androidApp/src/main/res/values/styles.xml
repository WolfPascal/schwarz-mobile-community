<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobileCommunity" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FAFBFC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MobileCommunity.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAFBFC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MobileCommunity</item>
    </style>
</resources>
